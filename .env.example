# Required by the guest book. These are public client values; see README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Maps JavaScript API key for the location map on the check-in form (restrict it to your domain).
# Leave empty to show the form without a map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Never put database passwords, CLI tokens, secret keys, or service-role keys in EXPO_PUBLIC_ variables.
