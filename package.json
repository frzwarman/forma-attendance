{
  "name": "forma-workforce",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/domain/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "db:login": "supabase login",
    "db:link": "node --env-file=.env.supabase.local scripts/supabase-link.cjs",
    "db:plan": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:status": "supabase migration list",
    "db:types": "node scripts/supabase-types.cjs",
    "db:test": "node --test tests/database/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~58.0.8",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
