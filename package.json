{
  "name": "event-guest-book",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "npm run build:web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:login": "supabase login",
    "db:link": "node --env-file=supabase/.env.cli.local scripts/supabase-link.cjs",
    "db:plan": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:status": "supabase migration list",
    "db:types": "node scripts/supabase-types.cjs",
    "db:test": "node --test tests/database/*.test.mjs",
    "weight": "node scripts/report-weight.cjs",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/google.maps": "^3.66.7",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~58.0.8",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
