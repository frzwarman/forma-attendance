{
  "expo": {
    "name": "Forma · Work, in rhythm",
    "slug": "fariz",
    "scheme": "forma",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Forma Workforce",
      "themeColor": "#5851DB"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Forma uses your location only when you verify attendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take an attendance selfie. No facial recognition is performed.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.forma.workforce",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.forma.workforce",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d03b8d5-2e14-4786-abce-68620e40acf2"
      }
    },
    "owner": "farizwrmns-team"
  }
}
