{
  "expo": {
    "name": "Buku Tamu",
    "slug": "fariz",
    "scheme": "forma",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Buku Tamu",
      "themeColor": "#00243f",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "bundleIdentifier": "com.forma.workforce",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.forma.workforce",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#1D1B1A"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5d03b8d5-2e14-4786-abce-68620e40acf2"
      }
    },
    "owner": "farizwrmns-team"
  }
}
